{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "pi-deck",
  "version": "0.1.17",
  "identifier": "dev.matheus.pideck",
  "build": {
    "devUrl": "http://localhost:1420",
    "frontendDist": "../ui/dist",
    "beforeDevCommand": "npm --prefix ui run dev",
    "beforeBuildCommand": "npm --prefix ui run build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "pi-deck",
        "width": 1280,
        "height": 820,
        "url": "index.html"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost ws://localhost:1420 https://registry.npmjs.org; object-src 'none'; base-uri 'self'; form-action 'self'"
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}

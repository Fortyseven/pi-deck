{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "pi-deck",
  "version": "0.1.0",
  "identifier": "dev.matheus.pideck",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "pi-deck",
        "width": 1280,
        "height": 820,
        "url": "index.html"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb"],
    "icon": ["icons/icon.png"],
    "category": "DeveloperTool",
    "publisher": "Matheus Dutra",
    "copyright": "© 2026 Matheus Dutra (MIT)",
    "shortDescription": "Desktop client for the pi coding agent",
    "longDescription": "pi-deck is a desktop client for the pi coding agent: sessions grouped by project, live subagent runs, markdown transcripts with tool cards, model and thinking controls."
  }
}
